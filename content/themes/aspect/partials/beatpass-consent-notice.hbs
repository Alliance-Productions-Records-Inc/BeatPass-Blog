<section id="bp-consent-notice" class="bp-consent-notice" aria-labelledby="bp-consent-title" aria-describedby="bp-consent-description" hidden>
    <div class="bp-consent-copy">
        <h2 id="bp-consent-title" tabindex="-1">Your privacy choices</h2>
        <p id="bp-consent-description">With your permission, BeatPass uses Google Analytics cookies to understand visits across our sites. Before you accept, only cookieless measurement is sent. Your choice applies across BeatPass and you can change it at any time. <a href="https://open.beatpass.ca/pages/privacy-policy">Privacy policy</a></p>
    </div>
    <div class="bp-consent-actions">
        <button type="button" data-bp-consent="granted">Accept</button>
        <button type="button" data-bp-consent="denied">Refuse</button>
    </div>
</section>
