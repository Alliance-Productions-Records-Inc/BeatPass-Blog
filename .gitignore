# ──────────────────────────────────────────────────────────────────────────────
# Ghost CMS — blog.beatpass.ca
# ──────────────────────────────────────────────────────────────────────────────

# ── Credentials & Environment ────────────────────────────────────────────────
.env
.env.*
!.env.example
config.production.json
config.development.json
.ghost-cli

# ── Ghost Core (installed, not custom code) ──────────────────────────────────
versions/
current

# ── Ghost Content (runtime data, uploads, DB) ───────────────────────────────
content/data/
content/images/
content/media/
content/files/
content/logs/
content/settings/
content/public/
content/apps/
content/themes/
content/offline-articles/

# ── Docs (raw content, credentials, internal notes) ─────────────────────────
docs/

# ── Content Designer (separate repo: BeatPass-ContentDesigner) ──────────────
content-designer/
content-generator/

# ── Node / Dependencies ─────────────────────────────────────────────────────
node_modules/

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
*.log.*

# ── Scripts runtime artifacts ────────────────────────────────────────────────
scripts/video-cache/
scripts/video-tmp/
scripts/bin/
scripts/*.pid
scripts/youtube-sync-state.json

# ── Build output ─────────────────────────────────────────────────────────────
dist/

# ── OS files ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── IDE ──────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── SSL / ACME ───────────────────────────────────────────────────────────────
.well-known/

# Supervisor runtime coordination (must remain on disk while running)
scripts/ghost-supervisor.lock
scripts/ghost-supervisor.stop
__pycache__/
*.pyc

# Local CMS content and unpublished editorial material (never public source)
/content/
/BeatPass_Editorial_Plan_*.xlsx
/BeatPass_SEO_Editorial_Report_*.html
/EDITORIAL_*.md

# Historical editorial jobs contain internal copy and commissioning details
/scripts/*-20??-??-??.js
/scripts/reconcile-editorial-workbook-*.py
/scripts/build-editorial-audio-*.py

# Local agent configuration and cloud credentials
/.claude/
/.codex/
/.agents/
/.aws/

# Credential files and database/backup exports
*.pem
*.key
*.p12
*.pfx
*.jks
*.sql
*.sql.gz
*.sqlite
*.sqlite3
*.db
*.bak
*.backup
*.dump
/config.*.json
